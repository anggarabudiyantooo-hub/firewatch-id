# Salin file ini menjadi .env lalu isi nilainya.
# Kunci HANYA dibaca di server (tidak pernah dikirim ke browser).

# NASA FIRMS MAP_KEY gratis: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=

# Sumber FIRMS: VIIRS_SNPP_NRT | VIIRS_NOAA20_NRT | MODIS_NRT
FIRMS_SOURCE=VIIRS_SNPP_NRT

# Jumlah hari data (1-10)
FIRMS_DAYS=1

PORT=3000

# Secret wajib di Vercel Production dan GitHub Actions untuk /api/cron.
# Gunakan nilai acak yang sama di kedua tempat; jangan commit nilai sebenarnya.
CRON_SECRET=

# Opsional; endpoint diagnostik Sentinel menerima secret hanya lewat Bearer header.
DEBUG_KEY=

# ---------- Operations Center ----------
# Penyimpanan insiden/alert. Pilih SALAH SATU; tanpa keduanya, produksi
# berjalan dengan penyimpanan sementara dan mengatakannya di halaman.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
OPS_GITHUB_TOKEN=
OPS_GITHUB_REPO=

# RBAC Operations Center. Atur setidaknya satu token di production;
# tanpa token, semua API data operasi fail-closed (503).
#   VIEWER   → membaca data operasi
#   OPERATOR → menangani insiden (buat, catatan, tugaskan, eskalasi, selesai, tutup)
#   ADMIN    → semua di atas + memicu evaluasi (mengambil data hulu)
# OPS_WRITE_TOKEN lama tetap dihormati sebagai token tingkat ADMIN.
OPS_TOKEN_VIEWER=
OPS_TOKEN_OPERATOR=
OPS_TOKEN_ADMIN=
OPS_WRITE_TOKEN=
# OPS_READ_PROTECTED sudah usang dan diabaikan; baca selalu perlu VIEWER ke atas.

# Berkas simpanan mode file (pengembangan/uji). Bawaan: .data/ops.json
OPS_STORE_FILE=

# Ambang pemantauan (opsional, default ditulis di README).
OPS_FRESH_STALE_MULT=1.5
OPS_FRESH_CRIT_MULT=6
OPS_SLOW_MS=4000
OPS_HOTSPOT_CLUSTER=50
OPS_HOTSPOT_MAX=5
# Di Vercel: pengukuran sekali saat rute ops dibuka pada instance yang belum
# mengukur apa pun (detik). 0 = matikan.
OPS_WARMUP_MS=8000
OPS_ALERT_DEDUP_MS=1800000
OPS_SLA_CRITICAL_MIN=60
OPS_SLA_HIGH_MIN=240
OPS_SLA_MEDIUM_MIN=1440
OPS_SLA_LOW_MIN=4320

