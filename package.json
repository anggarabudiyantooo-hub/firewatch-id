{
  "name": "firewatch-id",
  "version": "1.0.0",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "check": "node scripts/check-style.js && node scripts/check-bundle.js && node scripts/test-atmos.js && node scripts/test-ops.js",
    "test": "node scripts/test-atmos.js",
    "refresh:snapshots": "node scripts/refresh-snapshots.js",
    "refresh:pvmbg": "node scripts/refresh-snapshots.js --only-pvmbg",
    "refresh:regions": "node scripts/refresh-snapshots.js --only-regions"
  },
  "keywords": [
    "karhutla",
    "wildfire",
    "indonesia",
    "firms",
    "leaflet",
    "open-data",
    "himawari"
  ],
  "author": "anggarabudiyantooo-hub",
  "license": "MIT",
  "description": "Pemantauan karhutla Indonesia: titik api, sebaran asap, kualitas udara, abu vulkanik, dan atribusi tanggung jawab lahan, dari data terbuka.",
  "dependencies": {
    "@mapbox/vector-tile": "1.3.1",
    "compression": "^1.8.1",
    "express": "^4.22.3",
    "grib2-simple": "^1.1.1",
    "helmet": "^8.3.0",
    "leaflet": "^1.9.4",
    "pbf": "^5.1.2"
  },
  "private": true,
  "engines": {
    "node": ">=20 <23"
  },
  "devDependencies": {
    "playwright": "^1.55.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anggarabudiyantooo-hub/firewatch-id.git"
  },
  "homepage": "https://firewatch-id.vercel.app",
  "bugs": {
    "url": "https://github.com/anggarabudiyantooo-hub/firewatch-id/issues"
  }
}
